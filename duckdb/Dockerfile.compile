# 使用 DolphinDB 官方镜像作为基础
FROM dolphindb/dolphindb:v2.00.10 AS builder

USER root

# 安装编译依赖
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    g++ \
    wget \
    && rm -rf /var/lib/apt/lists/*

# 创建工作目录
WORKDIR /build

# 复制插件源代码
COPY duckdb /build/duckdb/

# 下载 DuckDB 源码
WORKDIR /build/duckdb
RUN if [ ! -d "contrib/duckdb" ] || [ ! -f "contrib/duckdb/CMakeLists.txt" ]; then \
    mkdir -p contrib && \
    cd contrib && \
    wget -q https://github.com/duckdb/duckdb/archive/refs/tags/v1.1.3.tar.gz && \
    tar -xzf v1.1.3.tar.gz && \
    mv duckdb-1.1.3 duckdb && \
    rm v1.1.3.tar.gz; \
    fi

# 设置库路径
ENV LD_LIBRARY_PATH=/data/ddb/server:$LD_LIBRARY_PATH

# 编译插件
WORKDIR /build/duckdb/build
RUN cmake -DCMAKE_BUILD_TYPE=Release .. && \
    make -j$(nproc)

# 验证编译结果
RUN ls -la /build/duckdb/build/libPluginDuckDB.so

# 运行阶段 - 创建包含插件的完整镜像
FROM dolphindb/dolphindb:v2.00.10

USER root

# 复制编译好的插件
COPY --from=builder /build/duckdb/build/libPluginDuckDB.so /opt/dolphindb/server/plugins/duckdb/
COPY --from=builder /build/duckdb/PluginDuckDB.txt /opt/dolphindb/server/plugins/duckdb/

# 创建插件目录（如果不存在）
RUN mkdir -p /opt/dolphindb/server/plugins/duckdb

# 修复权限
RUN chown -R dolphindb:dolphindb /opt/dolphindb/server/plugins/duckdb

USER dolphindb

# 暴露端口
EXPOSE 8848

# 启动命令保持不变
CMD ["sh", "-c", "cd /data/ddb/server && export LD_LIBRARY_PATH=/data/ddb/server:$LD_LIBRARY_PATH && ./dolphindb -console 0 -mode single -home /data/ddb -script dolphindb.dos -config dolphindb.cfg -logFile /data/ddb/log/dolphindb.log"]
