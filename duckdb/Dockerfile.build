# 用于编译 DuckDB 插件的 Docker 镜像
FROM ubuntu:22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装编译依赖
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    build-essential \
    g++ \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# 创建编译目录
WORKDIR /build

# 复制插件源代码
COPY . /build/duckdb_plugin/

# 设置入口点
CMD ["/bin/bash"]
