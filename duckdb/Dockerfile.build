# 用于编译 DuckDB 插件的 Dockerfile
FROM ubuntu:22.04

# 安装编译依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    python3 \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /build

# 复制插件源代码
COPY . /build/DolphinDBPlugin/

# 编译 DuckDB 插件
WORKDIR /build/DolphinDBPlugin/duckdb

# 初始化子模块
RUN git submodule update --init --recursive || true

# 创建构建目录
RUN mkdir -p build

# 编译
WORKDIR /build/DolphinDBPlugin/duckdb/build
RUN cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# 输出目录
RUN mkdir -p /output && \
    cp /build/DolphinDBPlugin/duckdb/build/libPluginDuckDB.so /output/ && \
    cp /build/DolphinDBPlugin/duckdb/PluginDuckDB.txt /output/

CMD ["cp", "-r", "/output/", "/host-output/"]
